# ==============================================================================
# DARELIMAN EDU — ENVIRONMENT CONFIGURATION UNTUK SERVER PRODUCTION (LIVE)
# ==============================================================================
# Gunakan file ini sebagai template .env pada direktori backend di server PRODUCTION.
# Salin file ini menjadi: backend/.env
# ==============================================================================

APP_NAME="Dareliman Edu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.dareliman.sch.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# DATABASE POSTGRESQL PRODUCTION
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=school_management_prod
DB_USERNAME=postgres_prod
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_PROD_YANG_KUAT_DAN_UNIK

# ------------------------------------------------------------------------------
# ATURAN SEEDER PRODUCTION (100% MASTER DATA RIIL YAYASAN & SANTRI SIPDEI)
# ------------------------------------------------------------------------------
# SEED_DUMMY_DATA=false   : MUTLAK DILARANG data dummy masuk ke server produksi
# SEED_TEST_ACCOUNTS=false : TIDAK MEN-SEED akun test santri/role buatan
# Hasil Database Production: Tepat 2.549 Santri Riil Yayasan (0 Akun Test, 0 Dummy)
SEED_DUMMY_DATA=false
SEED_TEST_ACCOUNTS=false

# ------------------------------------------------------------------------------
# INTEGRASI SIPDEI LIVE (KEUANGAN & TAGIHAN SISWA)
# ------------------------------------------------------------------------------
SIPDEI_BASE_URL=https://sipdei.dareliman.tech
SIPDEI_API_KEY=8c64e0685f8619a599e93a5a2c8b8c689ba42407770172cb9d89f25940c48753
SIPDEI_CACHE_TTL=600

# ------------------------------------------------------------------------------
# SESI, CACHE, DAN QUEUE (PRODUCTION: REDIS / DATABASE)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=dareliman_prod_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# CORS & FRONTEND DOMAINS PRODUCTION
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=edu.dareliman.sch.id
SESSION_SECURE_COOKIE=true

