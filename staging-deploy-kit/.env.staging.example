# ==============================================================================
# DARELIMAN EDU — ENVIRONMENT CONFIGURATION UNTUK SERVER STAGING
# ==============================================================================
# Gunakan file ini sebagai template .env pada direktori backend di server staging.
# Salin file ini menjadi: backend/.env
# ==============================================================================

APP_NAME="Dareliman Edu (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://demoapi.dareliman.sch.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# DATABASE POSTGRESQL STAGING
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=school_management_staging
DB_USERNAME=postgres_staging
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_STAGING_ANDA

# ------------------------------------------------------------------------------
# ATURAN SEEDER STAGING (2.549 SANTRI RIIL SIPDEI + 6 AKUN TEST ROLE)
# ------------------------------------------------------------------------------
# SEED_DUMMY_DATA=false : Mencegah data dummy/mocking lama masuk ke database
# SEED_TEST_ACCOUNTS=true : Men-seed akun uji coba multi-peran (Superadmin, Kepsek, Guru, Musyrif, Orang Tua)
# Hasil Database Staging: Tepat 2.555 Santri (2.549 Riil SIPDEI + 6 Akun Test Terpadu)
SEED_DUMMY_DATA=false
SEED_TEST_ACCOUNTS=true

# ------------------------------------------------------------------------------
# INTEGRASI SIPDEI LIVE (KEUANGAN & TAGIHAN SISWA)
# ------------------------------------------------------------------------------
SIPDEI_BASE_URL=https://sipdei.dareliman.tech
SIPDEI_API_KEY=8c64e0685f8619a599e93a5a2c8b8c689ba42407770172cb9d89f25940c48753
SIPDEI_CACHE_TTL=600

# ------------------------------------------------------------------------------
# SESI, CACHE, DAN QUEUE
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=dareliman_staging_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# CORS & FRONTEND DOMAINS
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=demoedu.dareliman.sch.id,localhost:5173
SESSION_SECURE_COOKIE=true

